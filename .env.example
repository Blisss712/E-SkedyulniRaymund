# Member accounts and the Supabase-backed features. When both values are set the
# app enables sign in / sign up (email, Google, Facebook, phone OTP) and reads
# availability, open slots, and notifications directly from Supabase.
# Copy this file to .env.local and fill in your project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The FastAPI admin service is optional. When it is empty, admin sign-in uses
# Supabase Auth directly (email or admin username with the account password, and
# administrator access from admin_profiles). The offline demo account
# (admin / admin123) only exists when Supabase is unconfigured too.
VITE_ADMIN_API_URL=http://127.0.0.1:8000
# Optional; defaults to VITE_ADMIN_API_URL for member data requests.
VITE_MEMBER_API_URL=http://127.0.0.1:8000
