DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@eskedyul.app
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_FULL_NAME=Platform Admin
CORS_ORIGINS=http://localhost:8443
AUTO_CREATE_TABLES=false

# Ministry assistant (server-side key; never expose it to the browser).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier 3.x Flash model. 3.6 Flash is the working free default; newer
# models such as 3.8 Flash can be set here when they are available.
GEMINI_MODEL=gemini-3.6-flash
# If the primary model is busy or unavailable, try these in order.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Optional override for tests or a proxy; defaults to Google's API.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
